# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only these confirmed email(s) get admin rights (comma separated)
ADMIN_EMAIL=bittu280902@gmail.com

# 32+ random characters, signs participant sessions and hashes one-time codes
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
